# COVERT mainnet deployment configuration.
# Copy to cairo/.env.deploy and fill in. NEVER commit .env.deploy.
# Secrets (keystore) live outside the repo and are never referenced by value here.

# Starknet Mainnet RPC. Use a personal RPC provider (Alchemy recommended) for signing.
# For read-only verification only, a public RPC also works: https://starknet-rpc.publicnode.com
MAINNET_RPC_URL="https://starknet-mainnet.g.alchemy.com/starknet/version/rpc/v0_10/YOUR_KEY"

# Account for signing. Two supported modes:
#
# A) sncast keystore mode (recommended): create once with
#      starkli signer keystore from-key ~/.covert/deployer.keystore     # prompts for the key + password
#      starkli account fetch <ADDRESS> --output ~/.covert/deployer_account.json --rpc <RPC>
#    Then:
#      DEPLOY_KEYSTORE=~/.covert/deployer.keystore
#      DEPLOY_ACCOUNT_FILE=~/.covert/deployer_account.json
#
# B) sncast accounts-file mode:
#      sncast account import --name covert-deployer --address <ADDR> --type oz --private-key-file <SECRET_FILE>
#    Then:
#      DEPLOY_ACCOUNT_NAME=covert-deployer
# (Ledger hardware wallet is also supported via `sncast account create --ledger-*`.)
DEPLOY_KEYSTORE=""
DEPLOY_ACCOUNT_FILE=""
DEPLOY_ACCOUNT_NAME=""

# Protocol addresses (already independently verified).
# STRK token on Starknet mainnet (Voyager "Official STRK token", starknet-io/starknet-addresses).
STRK_TOKEN="0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d"
# Official STRK20 privacy pool on Starknet mainnet (verified via L2BEAT + Voyager).
STRK20_POOL="0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a"

# COVERT roles.
# OWNER_ADDRESS: controls configure_anonymizer + fund_reserve (the deployer account is a safe default).
# ADJUDICATOR_ADDRESS: decides claims (approve/deny) only; cannot touch economics or reserve.
OWNER_ADDRESS=""
ADJUDICATOR_ADDRESS=""

# Deliberately tiny competition reserve, in wei (1 STRK = 1000000000000000000 wei).
RESERVE_WEI="1000000000000000000"