# ---------------------------------------------------------------------------
# COVERT frontend configuration.
# Copy to .env.local. Nothing here is a secret; never put a private key in it.
# ---------------------------------------------------------------------------

# Alchemy Starknet key suffix. Optional — COVERT falls back to a public RPC for
# reads, but a dedicated endpoint is strongly recommended for anything real.
NEXT_PUBLIC_PROVIDER_URL=

# Optional explicit RPC URL, tried after the Alchemy endpoint and before the
# public fallback. Useful for pointing the app at a local devnet.
NEXT_PUBLIC_RPC_URL=

# COVERT deployment. 0x0 means "not deployed": every surface reports NOT_DEPLOYED
# and offers the verified replay instead of pretending to be live.
NEXT_PUBLIC_COVERT_POLICY_ADDRESS=0x0
NEXT_PUBLIC_COVERT_ANONYMIZER_ADDRESS=0x0

# Which network the addresses above live on. Anything other than "mainnet" is
# labelled as such in the UI so a testnet deployment is never shown as mainnet.
NEXT_PUBLIC_COVERT_NETWORK=mainnet

# Explorer links.
NEXT_PUBLIC_VOYAGER_BASE=https://voyager.online/tx
NEXT_PUBLIC_VOYAGER_CONTRACT_BASE=https://voyager.online/contract
